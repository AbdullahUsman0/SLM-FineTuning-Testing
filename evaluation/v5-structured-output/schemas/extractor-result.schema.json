{
  "$defs": {
    "Intent": {
      "enum": [
        "create_forecast",
        "not_forecasting",
        "ambiguous",
        "unsupported"
      ],
      "title": "Intent",
      "type": "string"
    },
    "SlotStatus": {
      "enum": [
        "unmentioned",
        "provided",
        "inferred",
        "ambiguous",
        "conflicting",
        "invalid",
        "dont_care",
        "confirmed"
      ],
      "title": "SlotStatus",
      "type": "string"
    },
    "SlotUpdate": {
      "properties": {
        "slot_id": {
          "title": "Slot Id",
          "type": "string",
          "enum": [
            "intent",
            "problem_statement",
            "business_goal",
            "stakeholder_role",
            "decision_supported",
            "success_criteria",
            "target_column",
            "target_description",
            "target_unit",
            "target_bounds",
            "allow_negative_values",
            "aggregation_method",
            "time_column",
            "frequency",
            "timezone",
            "calendar_type",
            "forecast_horizon",
            "forecast_start",
            "data_cutoff",
            "lead_time",
            "dataset_type",
            "series_id_columns",
            "hierarchy_columns",
            "aggregation_level",
            "scope_filters",
            "geography",
            "source_mode",
            "source_reference",
            "source_provider",
            "file_format",
            "sheet_or_table",
            "authentication_reference",
            "refresh_frequency",
            "history_start",
            "history_end",
            "expected_history_length",
            "minimum_training_points",
            "known_regime_changes",
            "missing_timestamp_policy",
            "missing_target_policy",
            "duplicate_policy",
            "outlier_policy",
            "invalid_value_policy",
            "minimum_coverage",
            "known_seasonality",
            "seasonal_periods",
            "business_days_only",
            "holidays",
            "special_events",
            "past_covariates",
            "known_future_covariates",
            "static_features",
            "covariate_availability",
            "external_covariate_sources",
            "forecast_type",
            "prediction_interval_levels",
            "quantiles",
            "scenario_forecasts",
            "rounding_rule",
            "output_granularity",
            "primary_metric",
            "secondary_metrics",
            "validation_strategy",
            "backtest_folds",
            "test_window",
            "baseline_model",
            "acceptable_error",
            "inference_mode",
            "prediction_frequency",
            "retraining_frequency",
            "latency_requirement",
            "output_format",
            "destination",
            "contains_sensitive_data",
            "privacy_constraints",
            "license",
            "provenance_required",
            "explainability_level",
            "human_approval_required"
          ]
        },
        "candidate_value": {
          "default": null,
          "title": "Candidate Value",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SlotStatus"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_text": {
          "title": "Evidence Text",
          "type": "string"
        }
      },
      "required": [
        "slot_id",
        "candidate_value",
        "status",
        "confidence",
        "evidence_text"
      ],
      "title": "SlotUpdate",
      "type": "object",
      "additionalProperties": false
    }
  },
  "properties": {
    "intent": {
      "$ref": "#/$defs/Intent"
    },
    "intent_confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Intent Confidence",
      "type": "number"
    },
    "updates": {
      "items": {
        "$ref": "#/$defs/SlotUpdate"
      },
      "title": "Updates",
      "type": "array"
    },
    "correction_detected": {
      "default": false,
      "title": "Correction Detected",
      "type": "boolean"
    },
    "unsupported_claims": {
      "items": {
        "type": "string"
      },
      "title": "Unsupported Claims",
      "type": "array"
    }
  },
  "required": [
    "intent",
    "intent_confidence",
    "updates",
    "correction_detected",
    "unsupported_claims"
  ],
  "title": "ExtractorResult",
  "type": "object",
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural v5 contract. Duplicate slot IDs, evidence grounding, forbidden slots, and state-dependent semantics require application validation."
}
