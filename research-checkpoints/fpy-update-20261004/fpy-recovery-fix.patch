+@pytest.mark.asyncio
+async def test_source_mode_recovery_preserves_other_extracted_requirements() -> None:
+    message = (
+        "Forecast daily maximum temperature for Lahore. The target is measured in Celsius. "
+        "Each observation covers 1 day. Predict the next 7 days. "
+        "The target column is tmax. I will upload weather.csv in csv format."
+    )
+    values = {
+        "target_description": ("daily maximum temperature for Lahore", "Forecast daily maximum temperature for Lahore."),
+        "target_unit": ("Celsius", "The target is measured in Celsius."),
+        "frequency": ({"periods": 1, "unit": "day"}, "Each observation covers 1 day."),
+        "forecast_horizon": ({"periods": 7, "unit": "day"}, "Predict the next 7 days."),
+        "target_column": ("tmax", "The target column is tmax."),
+        "file_format": ("csv", "I will upload weather.csv in csv format."),
+    }
+    client = FakeLLMClient([
+        ExtractorResult(
+            intent=Intent.CREATE_FORECAST,
+            intent_confidence=0.99,
+            updates=[_update(slot_id, value, evidence=evidence)
+                     for slot_id, (value, evidence) in values.items()],
+        )
+    ])
+    engine, repository, dialogue_id = await _start(client)
+
+    result = await engine.handle_user_message(dialogue_id, message)
+
+    assert result.state.intent == Intent.CREATE_FORECAST
+    assert result.state.slots["source_mode"].value == "upload"
+    for slot_id, (expected, _) in values.items():
+        assert result.state.slots[slot_id].value == expected
+    stored = repository.load_state(dialogue_id)
+    assert stored.slots["target_description"].value == values["target_description"][0]
+    assert stored.slots["source_reference"].value is None
+    assert len(client.extract_requests) == 1
+
+
