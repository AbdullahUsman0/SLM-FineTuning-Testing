+def acknowledge_known_target(request: QuestionRequest, target: str) -> QuestionRequest:
+    """Adjust missing task wording without treating an example as a user value."""
+    if request.slot_id != "problem_statement" or request.current_state.status != SlotStatus.UNMENTIONED:
+        return request
+    # A target is user text: redact it, keep one question mark, and leave enough
+    # room for both the acknowledgement and example in the 300-character limit.
+    label = " ".join(str(safe_provider_value(target)).replace("?", " ").split())
+    if not label:
+        return request
+    if len(label) > 64:
+        label = label[:61].rstrip() + "..."
+    return request.model_copy(update={
+        "static_question": (
+            f'You mentioned "{label}" as the target. '
+            "How would you summarize the overall forecasting task in one sentence?"
+        ),
+        "example_answer": f"Forecast {label}",
+    })
+
+
